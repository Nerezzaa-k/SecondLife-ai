# ==============================================================================
# SecondLife AI - Environment Variables Template
# ==============================================================================
# All API keys must remain strictly on the server side. Never expose secrets to
# the client bundle. Copy this file to .env and fill in your values.
# ==============================================================================

# Server Listening Port (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Google Gemini Vision API Key (Required for live AI multimodal item diagnostics)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Media Processing Pipeline (Required for authenticated server uploads,
# background removal, optical smart crops, and auto-tagging)
# Obtain from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Supabase Authentication & PostgreSQL Database (Phase 2)
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Application Public Host URL (Optional, for OAuth callbacks or self-referential links)
APP_URL=http://localhost:3000

# CORS Allowed Origin (defaults to APP_URL or http://localhost:3000)
ALLOWED_ORIGIN=http://localhost:3000
